        // 构建 SVG foreignObject
        var svgNs = 'http://www.w3.org/2000/svg';
        var xhtmlNs = 'http://www.w3.org/1999/xhtml';
        var svgData = '<svg xmlns="' + svgNs + '" width="' + width + '" height="' + height + '">' +
